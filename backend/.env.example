# URL de conexión de Supabase PostgreSQL (Transaction Pooler recomendado).
DATABASE_URL=postgresql://usuario:contrasena@host:6543/postgres
DATABASE_SSL=true

# URL pública del proyecto frontend ya desplegado.
FRONTEND_URL=https://tu-frontend.vercel.app

# Credenciales privadas del panel administrador.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_TOKEN_SECRET=genera-una-clave-larga-aleatoria

# Solo backend: permite crear cuentas mayoristas desde Administración → Clientes.
# Con la clave pública funciona como registro normal; la service role es opcional
# y permite crear/borrar cuentas administrativamente. Nunca copies secretos al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
