# URL de conexión de PostgreSQL (Supabase, servidor propio, etc.).
DATABASE_URL=postgresql://usuario:contrasena@host:5432/base
# TLS: true si el servidor exige SSL (Supabase lo exige), false si no.
# Si se omite, se deduce del host.
DB_SSL=true

# URL pública del proyecto frontend ya desplegado.
FRONTEND_URL=https://tu-frontend.vercel.app

# Credenciales privadas del panel administrador.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_TOKEN_SECRET=genera-una-clave-larga-aleatoria

# Solo backend: permite crear cuentas mayoristas desde Administración → Clientes.
# Con la clave pública funciona como registro normal; la service role es opcional
# y permite crear/borrar cuentas administrativamente. Nunca copies secretos al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Integración privada con el ERP de TERRA. Solo backend; nunca se exponen al frontend.
TERRA_ERP_BASE_URL=http://servidor-erp-interno:puerto
TERRA_ERP_API_USER=usuario-entregado-por-terra
TERRA_ERP_API_PASSWORD=clave-entregada-por-terra
# Bucket público de Supabase que recibirá las imágenes descargadas del ERP.
SUPABASE_STORAGE_BUCKET=product-images
