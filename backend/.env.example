# URL de conexión de PostgreSQL.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/base
# TLS en la conexión a PostgreSQL: true o false (por defecto false; la base actual
# conecta sin TLS). Cualquier otro valor impide arrancar.
DB_SSL=false

# URL pública del proyecto frontend ya desplegado.
FRONTEND_URL=https://tu-frontend.vercel.app

# Firmas de los tokens de sesión (obligatorias, mínimo 32 caracteres aleatorios cada una).
# Sin ellas el servidor no arranca. No existen usuarios ni contraseñas en variables de
# entorno: todo login se valida contra la base (staff_accounts y users).
# El primer administrador se crea con: node scripts/crear-admin.mjs
ADMIN_TOKEN_SECRET=genera-una-clave-larga-aleatoria
CLIENTE_TOKEN_SECRET=genera-otra-clave-larga-aleatoria

# Imágenes de producto: copyparty propio. El navegador nunca habla con copyparty, todo
# pasa por POST /api/archivos/productos. La contraseña es opcional: si está vacía se sube
# sin autenticación (cabecera PW solo cuando tiene valor).
COPYPARTY_URL=https://tu-copyparty.ejemplo.com
COPYPARTY_CARPETA_PRODUCTOS=imagens
COPYPARTY_PASSWORD=
COPYPARTY_TIMEOUT_MS=30000

# Integración privada con el ERP de TERRA ("API TERRA – Guía de conexión v1.2").
# Solo backend; nunca se exponen al frontend ni a public/config.js.
TERRA_ERP_URL=https://192.168.0.82:9433
TERRA_ERP_API_USER=usuario-entregado-por-terra
TERRA_ERP_API_PASSWORD=clave-entregada-por-terra
# Certificado (.crt/.pem) de la CA de TERRA. Sin él se usa el almacén del sistema;
# nunca se desactiva la verificación TLS.
TERRA_ERP_CA_CERT_PATH=
TERRA_ERP_TIMEOUT_MS=20000           # cotización
TERRA_ERP_TIMEOUT_CONSULTA_MS=10000  # consulta de producto y token
TERRA_ERP_CONCURRENCIA=5             # consultas de producto en paralelo
TERRA_ERP_HABILITADO=true            # false = cobrar sin ERP (solo desarrollo)
# Único almacén cuyo stock cuenta para vender (los demás se guardan solo como referencia).
TERRA_ERP_ALMACEN_VENTA=ALMACEN CENTRAL
